{
  "name": "dsh-chat-plugin",
  "version": "1.5.0",
  "type": "module",
  "description": "dsh Chat：dsh 之间的信使。把多台 dsh 连成聊天室，人和 agent 都能收发消息，支持端到端加密、agent 自动回复与 chat_ask 同步问答。",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "bundle",
    "chat",
    "im",
    "agent",
    "agent-to-agent",
    "p2p",
    "ntfy",
    "relay",
    "e2e-encryption"
  ],
  "author": "unfar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unfar/dsh-chat-plugin.git"
  },
  "homepage": "https://github.com/unfar/dsh-chat-plugin#readme",
  "bugs": {
    "url": "https://github.com/unfar/dsh-chat-plugin/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "relay/relay.mjs",
    "README.md",
    "LICENSE",
    "docs/*.png"
  ],
  "scripts": {
    "test": "node test/smoke.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  }
}
